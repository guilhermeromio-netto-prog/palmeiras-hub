# ===== Palmeiras Hub — variáveis de ambiente =====
# Copie este arquivo para .env e preencha as chaves desejadas.
# Sem chaves, o app sobe em MODO DEMO com dados de exemplo (rotulados).

# Porta do servidor Express (proxy + API)
PORT=3001

# --- Opção 1: API-Football (api-sports.io) — recomendado ---
# Cadastro gratuito: https://dashboard.api-football.com/
# Header X-RapidAPI-Key / x-apisports-key
API_FOOTBALL_KEY=

# --- Opção 2: football-data.org (plano free) ---
# Cadastro: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Forçar modo demo mesmo com chaves (true/false)
FORCE_DEMO=false

# Cache em memória (segundos) — revalida a cada start do app no client
CACHE_TTL_SECONDS=120
