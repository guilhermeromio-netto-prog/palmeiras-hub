{
  "name": "palmeiras-hub",
  "private": true,
  "version": "3.8.0",
  "type": "module",
  "description": "Hub pessoal Palmeiras \u2014 r\u00e1dio + YouTube + torcida VERDAO + onde assistir",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "concurrently -k -n proxy,web -c green,cyan \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "npx --yes serve dist -p 4173",
    "start": "NODE_ENV=production node server/index.js",
    "lint": "oxlint"
  },
  "dependencies": {
    "@instantdb/react": "^1.0.67",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
