{
  "name": "palmeiras-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hub pessoal de torcedor do Palmeiras — jogos, tabela, estatísticas e notícias",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "lint": "oxlint"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-fetch": "^2.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.0.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
