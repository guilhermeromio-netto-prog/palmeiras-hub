    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.0.0",
    "sharp": "^0.35.4",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
